---
/**
 * 品牌 Logo 组件。
 *
 * 统一全站的品牌标记呈现方式，避免各处自行拼凑几何图形——
 * 那些「自造的菱形」看似呼应品牌，实则缺少四芒星与装饰弧线，
 * 观感上只是空心几何体，失去了品牌辨识度。
 *
 * 设计要点：
 *   · 使用从 logo矢量图.ai 精确提取的真实路径（public/brand/logo.svg）
 *   · 尺寸支持 maxSize 上限，避免在小屏上溢出
 *   · 通过 opacity 控制层次
 *   · 提供 alt 文本；纯装饰时传空字符串
 */
interface Props {
  /** 尺寸（px 数值，或任意 CSS 长度如 'var(--token)'） */
  size?: number | string;
  /** 尺寸上限（CSS 长度，如 '78vw'）；不传则不限制 */
  maxSize?: string;
  /** 无障碍标签；纯装饰时传空字符串 */
  label?: string;
  /** 额外 class */
  class?: string;
  /** 不透明度 */
  opacity?: number;
}

const {
  size = 32,
  maxSize,
  label = 'Yumesumi Center',
  class: className = '',
  opacity = 1,
} = Astro.props;

const base = import.meta.env.BASE_URL;

/** 数值按 px 处理，字符串视为完整 CSS 长度 */
const cssSize = typeof size === 'number' ? `${size}px` : size;

/** 有上限时用 min() 表达，保证小屏不溢出 */
const sizing = maxSize
  ? `inline-size:min(${cssSize},${maxSize});block-size:min(${cssSize},${maxSize})`
  : `inline-size:${cssSize};block-size:${cssSize}`;

/** width/height 属性只接受数值；CSS 长度由内联样式负责 */
const intAttr = typeof size === 'number' ? size : undefined;
---

<img
  class:list={['ys-logo', className]}
  src={`${base}brand/logo.svg`}
  alt={label}
  width={intAttr}
  height={intAttr}
  style={`${sizing};opacity:${opacity}`}
/>

<style>
  .ys-logo {
    display: block;
    flex-shrink: 0;
    /*
      Logo 本身是纯白线条，滤镜保证它在任何背景上都是白色，
      便于用 opacity 做层次控制。
      （brightness(0) invert(1) 对纯白图形无副作用，边缘依然锐利。）
    */
    filter: brightness(0) invert(1);
    transition:
      opacity var(--ys-dur-base) var(--ys-ease-out),
      transform var(--ys-dur-base) var(--ys-ease-out);
  }
</style>
