---
/**
 * 首页 Hero
 *
 * 构成：文字层 + 首屏装饰层。
 * 巨大的品牌标记已上移到固定环境层（HomeAmbience）——
 * 它不再随页面滚动离开，而是作为整站的底纹持续存在。
 * 这里保留首屏专属的文字扫光、扫描线与 HUD 角框，
 * 与固定环境层叠加出纵深与科技感。
 *
 * 视觉主体仍是 CSS；文字扫光用一小段原生脚本读取指针位置，
 * 不引入前端框架，也不使用 Astro 的 client:* 指令。
 */
import { SITE } from '@/data/site';

const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base}${href.replace(/^\//, '')}`;
---

<section class="hero" data-hero>
  <!-- 装饰层：全部为 aria-hidden 的纯视觉元素 -->
  <div class="hero__backdrop" aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__scan"></div>

    <!-- HUD 角框：四条细线限定的取景框，提供仪器感 -->
    <div class="hero__hud">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>

  <!-- 文字层 -->
  <div class="hero__content ys-container ys-container--wide">
    <h1 class="hero__wordmark" data-spotlight>
      <span class="hero__wordmark-line">YUMESUMI</span>
      <span class="hero__wordmark-line">CENTER</span>
    </h1>

    <p class="hero__name-zh" data-spotlight>
      梦澄中心
    </p>

    <p class="hero__lede">{SITE.tagline}</p>

    <div class="hero__actions">
      <a class="hero__cta" href={withBase('/projects/')}>
        <span>进入项目</span>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>

      <a class="hero__scroll" href="#introduction">
        <span class="hero__scroll-line" aria-hidden="true"></span>
        <span>继续探索</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-content: center;
    min-block-size: 100svh;
    padding-block: calc(var(--ys-nav-height) + var(--ys-space-2xl)) var(--ys-space-2xl);
    overflow: clip;
    isolation: isolate;
    /*
      首屏不再使用不透明底：固定环境层的水印与粒子透过这里呈现。
      只保留一层极淡的顶部紫雾，用来区分首屏与后续章节。
    */
    background: radial-gradient(
      120% 78% at 50% 6%,
      color-mix(in srgb, var(--ys-deep) 46%, transparent) 0%,
      color-mix(in srgb, var(--ys-night) 26%, transparent) 44%,
      transparent 76%
    );
  }

  /* ---------- 装饰层 ---------- */

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* 中心辉光，为标题提供空气感 */
  .hero__glow {
    position: absolute;
    inset-block-start: 51%;
    inset-inline-start: 50%;
    inline-size: min(92vw, 60rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--ys-purple) 22%, transparent) 0%,
      color-mix(in srgb, var(--ys-purple-deep) 12%, transparent) 42%,
      transparent 70%
    );
  }

  /* 扫描线：每隔一段时间自上而下掠过一道极淡的光 */
  .hero__scan {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 14%;
    block-size: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--ys-lavender) 24%, transparent) 28%,
      color-mix(in srgb, var(--ys-lavender-soft) 42%, transparent) 50%,
      color-mix(in srgb, var(--ys-lavender) 24%, transparent) 72%,
      transparent 100%
    );
    box-shadow: 0 0 22px var(--ys-accent-glow);
    opacity: 0;
    animation: ys-scan-sweep var(--ys-dur-scan) var(--ys-ease-smooth) infinite;
  }

  /* HUD 角框 */
  .hero__hud {
    position: absolute;
    inset-block-start: calc(var(--ys-nav-height) + var(--ys-space-sm));
    inset-block-end: var(--ys-space-lg);
    inset-inline: var(--ys-gutter);
    opacity: var(--ys-hud-opacity);
  }

  .hero__hud span {
    position: absolute;
    inline-size: clamp(1rem, 2vw, 1.75rem);
    aspect-ratio: 1;
    border: 0 solid color-mix(in srgb, var(--ys-lavender) 34%, transparent);
  }

  .hero__hud span:nth-child(1) {
    inset-block-start: 0;
    inset-inline-start: 0;
    border-block-start-width: 1px;
    border-inline-start-width: 1px;
  }

  .hero__hud span:nth-child(2) {
    inset-block-start: 0;
    inset-inline-end: 0;
    border-block-start-width: 1px;
    border-inline-end-width: 1px;
  }

  .hero__hud span:nth-child(3) {
    inset-block-end: 0;
    inset-inline-start: 0;
    border-block-end-width: 1px;
    border-inline-start-width: 1px;
  }

  .hero__hud span:nth-child(4) {
    inset-block-end: 0;
    inset-inline-end: 0;
    border-block-end-width: 1px;
    border-inline-end-width: 1px;
  }

  /* ---------- 文字层 ---------- */

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero__wordmark {
    /* 由 Hero 脚本写入的指针坐标；默认落在中心，无 JS 时也是完整的高光 */
    --mx: 50%;
    --my: 50%;
    display: grid;
    gap: 0.04em;
    margin: 0;
    font-size: var(--ys-fs-display);
    font-weight: var(--ys-weight-thin);
    line-height: var(--ys-lh-tight);
    letter-spacing: var(--ys-ls-tight);
    /*
      上层：跟随鼠标的径向高光；下层：冷白到薰衣草的静态渐变。
      高光区之外露出较暗的底层色，文字会随指针位置被"扫"亮。
    */
    background-image:
      radial-gradient(
        ellipse calc(var(--ys-spotlight-size) * 1.25) calc(var(--ys-spotlight-size) * 0.6) at
          var(--mx) var(--my),
        var(--ys-text) 0%,
        color-mix(in srgb, var(--ys-text) 62%, transparent) 46%,
        transparent 80%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ys-text) 52%, var(--ys-lavender)) 20%,
        color-mix(in srgb, var(--ys-lavender) 88%, var(--ys-text)) 78%,
        color-mix(in srgb, var(--ys-lavender) 82%, var(--ys-purple-bright)) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 36px color-mix(in srgb, var(--ys-void) 85%, transparent));
  }

  .hero__wordmark-line {
    display: block;
  }

  /*
    中文名只比英文标题小一档（display → 4xl）。
    字距放大、字重极细，与两侧渐隐细线一起构成"题名"的仪式感。
  */
  .hero__name-zh {
    --mx: 50%;
    --my: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--ys-space-md);
    margin-block: var(--ys-space-sm) 0;
    padding-inline-start: var(--ys-ls-cinematic);
    font-size: var(--ys-fs-4xl);
    font-weight: var(--ys-weight-thin);
    line-height: 1.12;
    letter-spacing: var(--ys-ls-cinematic);
    background-image:
      radial-gradient(
        ellipse calc(var(--ys-spotlight-size) * 1.15) calc(var(--ys-spotlight-size) * 0.55) at
          var(--mx) var(--my),
        var(--ys-text) 0%,
        color-mix(in srgb, var(--ys-text) 60%, transparent) 46%,
        transparent 80%
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--ys-text) 70%, var(--ys-lavender)) 0%,
        color-mix(in srgb, var(--ys-text) 38%, var(--ys-lavender)) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 22px var(--ys-void));
  }

  .hero__name-zh::before,
  .hero__name-zh::after {
    content: '';
    flex: 0 0 auto;
    inline-size: clamp(1.5rem, 7vw, 4.5rem);
    block-size: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--ys-lavender) 55%, transparent) 100%
    );
  }

  .hero__name-zh::after {
    transform: scaleX(-1);
  }

  .hero__lede {
    max-inline-size: 34rem;
    margin-block-start: var(--ys-space-lg);
    margin-inline: auto;
    font-size: var(--ys-fs-base);
    line-height: var(--ys-lh-relaxed);
    color: var(--ys-text-secondary);
    text-shadow:
      0 0 14px var(--ys-void),
      0 0 28px var(--ys-void);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--ys-space-lg);
    margin-block-start: var(--ys-space-xl);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--ys-space-2xs);
    padding: var(--ys-space-xs) var(--ys-space-md);
    border: 1px solid var(--ys-border-strong);
    border-radius: var(--ys-radius-pill);
    font-size: var(--ys-fs-sm);
    font-weight: var(--ys-weight-medium);
    letter-spacing: var(--ys-ls-wide);
    color: var(--ys-text);
    transition:
      border-color var(--ys-dur-base) var(--ys-ease-out),
      background-color var(--ys-dur-base) var(--ys-ease-out),
      box-shadow var(--ys-dur-base) var(--ys-ease-out),
      transform var(--ys-dur-base) var(--ys-ease-out);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    border-color: var(--ys-purple);
    background-color: color-mix(in srgb, var(--ys-purple) 14%, transparent);
    box-shadow:
      var(--ys-shadow-glow),
      inset 0 0 18px color-mix(in srgb, var(--ys-purple) 12%, transparent);
    transform: translateY(-2px);
  }

  .hero__cta svg {
    transition: transform var(--ys-dur-base) var(--ys-ease-out);
  }

  .hero__cta:hover svg {
    transform: translateX(3px);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--ys-space-2xs);
    font-size: var(--ys-fs-2xs);
    letter-spacing: var(--ys-ls-wider);
    text-transform: uppercase;
    color: var(--ys-text-muted);
    transition: color var(--ys-dur-base) var(--ys-ease-out);
  }

  .hero__scroll:hover {
    color: var(--ys-text-secondary);
  }

  .hero__scroll-line {
    position: relative;
    display: block;
    inline-size: 1px;
    block-size: 2.6rem;
    background: linear-gradient(to bottom, transparent, var(--ys-purple));
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inline-size: 100%;
    block-size: 40%;
    background: var(--ys-lavender);
    animation: ys-scroll-cue 2.4s var(--ys-ease-smooth) infinite;
  }

  /* ---------- 关键帧 ---------- */

  @keyframes ys-scan-sweep {
    0% {
      translate: 0 -8vh;
      opacity: 0;
    }
    10% {
      opacity: 0.45;
    }
    52% {
      opacity: 0.18;
    }
    68%,
    100% {
      translate: 0 74vh;
      opacity: 0;
    }
  }

  @keyframes ys-scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(250%);
    }
  }

  /* ---------- 响应式与降级 ---------- */

  @media (max-width: 767px) {
    .hero {
      min-block-size: 92svh;
    }

    .hero__lede {
      font-size: var(--ys-fs-sm);
    }

    .hero__actions {
      flex-direction: column;
      gap: var(--ys-space-md);
    }

    .hero__hud {
      display: none;
    }

    .hero__name-zh {
      gap: var(--ys-space-sm);
    }
  }

  /* 减少动态效果：停止扫描 */
  @media (prefers-reduced-motion: reduce) {
    .hero__scan {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  /**
   * 首屏文字扫光：把指针位置写进 --mx / --my，文字的径向高光随之移动。
   * 只写 CSS 变量，绘制与合成交给浏览器；pointermove 用 rAF 节流。
   * 减少动态效果时完全不绑定，保留默认的居中高光。
   */
  function initHeroSpotlight() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;

    const targets = Array.from(hero.querySelectorAll<HTMLElement>('[data-spotlight]'));
    if (targets.length === 0) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let frame = 0;
    let x = 0;
    let y = 0;

    const paint = () => {
      frame = 0;
      for (const el of targets) {
        const rect = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${x - rect.left}px`);
        el.style.setProperty('--my', `${y - rect.top}px`);
      }
    };

    const reset = () => {
      if (frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
      for (const el of targets) {
        el.style.setProperty('--mx', '50%');
        el.style.setProperty('--my', '50%');
      }
    };

    hero.addEventListener(
      'pointermove',
      (event) => {
        x = event.clientX;
        y = event.clientY;
        if (!frame) frame = requestAnimationFrame(paint);
      },
      { passive: true },
    );

    hero.addEventListener('pointerleave', reset);
  }

  initHeroSpotlight();
</script>
