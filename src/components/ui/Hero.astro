---
/**
 * 首页 Hero
 *
 * 构成：文字层 + 一枚置于其后的巨大品牌标记。
 * 品牌标记直接使用从 logo矢量图.ai 精确提取的真实路径（public/brand/logo.svg），
 * 以低透明度放大到远超字号的尺寸，作为背景图形与空间纵深，
 * 不与前景字标争夺注意力。
 *
 * 纯静态实现——不依赖 WebGL、不需要 JavaScript，
 * 在任何环境下都能完整呈现。
 */
import { SITE } from '@/data/site';
import BrandLogo from '@/components/ui/BrandLogo.astro';
import StarField from '@/components/ui/StarField.astro';

const base = import.meta.env.BASE_URL;
const withBase = (href: string) => `${base}${href.replace(/^\//, '')}`;
---

<section class="hero" data-hero>
  <!--
    背景层：巨大品牌标记。
    aria-hidden：装饰性图层，页面标题已完整表达站点身份，
    屏幕阅读器不需要重复朗读。
  -->
  <div class="hero__backdrop" aria-hidden="true">
    <StarField />
    <div class="hero__glow"></div>
    <div class="hero__mark">
      <BrandLogo size={520} maxSize="78vw" label="" opacity={0.16} />
    </div>
  </div>

  <!-- 文字层 -->
  <div class="hero__content ys-container ys-container--wide">
    <h1 class="hero__wordmark">
      <span class="hero__wordmark-line">YUMESUMI</span>
      <span class="hero__wordmark-line">CENTER</span>
    </h1>

    <p class="hero__eyebrow">{SITE.nameZh}</p>

    <p class="hero__lede">{SITE.tagline}</p>

    <div class="hero__actions">
      <a class="hero__cta" href={withBase('/projects/')}>
        <span>进入项目</span>
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>

      <a class="hero__scroll" href="#introduction">
        <span class="hero__scroll-line" aria-hidden="true"></span>
        <span>继续探索</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-content: center;
    min-block-size: 100svh;
    padding-block: calc(var(--ys-nav-height) + var(--ys-space-2xl)) var(--ys-space-2xl);
    overflow: clip;
    isolation: isolate;
    background: radial-gradient(
      120% 80% at 50% 8%,
      var(--ys-deep) 0%,
      var(--ys-night) 42%,
      var(--ys-abyss) 74%,
      var(--ys-void) 100%
    );
  }

  /* ---------- 背景层 ---------- */

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  /* 中心辉光，为巨大标记提供空气感 */
  .hero__glow {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: min(86vw, 54rem);
    aspect-ratio: 1;
    translate: -50% -52%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--ys-purple) 24%, transparent) 0%,
      color-mix(in srgb, var(--ys-purple-deep) 14%, transparent) 40%,
      transparent 70%
    );
    filter: blur(32px);
  }

  /*
    巨大品牌标记。
    尺寸经过调参：太小则失去存在感，太大则菱形框的边会跑出画面、
    只剩中央四芒星，反而认不出是 Logo。
    位置同样经过调整：整体略微下移，让四芒星实心区避开文字带，
    否则「梦澄中心」会被压在四芒星上难以辨认。
    保持正立不旋转——Logo 本身是轴对称的菱形，倾斜会破坏其几何秩序。
  */
  .hero__mark {
    position: absolute;
    inset-block-start: 53%;
    inset-inline-start: 50%;
    display: grid;
    place-items: center;
    translate: -50% -50%;
  }

  /* ---------- 文字层 ---------- */

  .hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero__eyebrow {
    margin-block: var(--ys-space-sm) var(--ys-space-md);
    font-size: var(--ys-fs-2xs);
    font-weight: var(--ys-weight-medium);
    letter-spacing: var(--ys-ls-widest);
    text-transform: uppercase;
    color: var(--ys-text-muted);
    /* 背景标记中央是四芒星，小字叠在上面会看不清——加一层暗底托住 */
    padding-block: var(--ys-space-3xs);
    text-shadow:
      0 0 12px var(--ys-void),
      0 0 24px var(--ys-void);
  }

  .hero__wordmark {
    display: grid;
    gap: 0.04em;
    margin: 0;
    font-size: var(--ys-fs-display);
    font-weight: var(--ys-weight-thin);
    line-height: var(--ys-lh-tight);
    letter-spacing: var(--ys-ls-tight);
    color: var(--ys-text);
    /* 柔光而非锐利发光，保持冷白字的干净边缘 */
    text-shadow: 0 0 90px color-mix(in srgb, var(--ys-void) 70%, transparent);
  }

  .hero__wordmark-line {
    display: block;
  }

  .hero__lede {
    max-inline-size: 34rem;
    margin-block-start: var(--ys-space-lg);
    margin-inline: auto;
    font-size: var(--ys-fs-base);
    line-height: var(--ys-lh-relaxed);
    color: var(--ys-text-secondary);
    /* 背景标记的底部叶形会穿过这一带，用暗底托住保证可读性 */
    text-shadow:
      0 0 14px var(--ys-void),
      0 0 28px var(--ys-void);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--ys-space-lg);
    margin-block-start: var(--ys-space-xl);
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--ys-space-2xs);
    padding: var(--ys-space-xs) var(--ys-space-md);
    border: 1px solid var(--ys-border-strong);
    border-radius: var(--ys-radius-pill);
    font-size: var(--ys-fs-sm);
    font-weight: var(--ys-weight-medium);
    letter-spacing: var(--ys-ls-wide);
    color: var(--ys-text);
    transition:
      border-color var(--ys-dur-base) var(--ys-ease-out),
      background-color var(--ys-dur-base) var(--ys-ease-out),
      transform var(--ys-dur-base) var(--ys-ease-out);
  }

  .hero__cta:hover,
  .hero__cta:focus-visible {
    border-color: var(--ys-purple);
    background-color: color-mix(in srgb, var(--ys-purple) 14%, transparent);
    transform: translateY(-2px);
  }

  .hero__cta svg {
    transition: transform var(--ys-dur-base) var(--ys-ease-out);
  }

  .hero__cta:hover svg {
    transform: translateX(3px);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--ys-space-2xs);
    font-size: var(--ys-fs-2xs);
    letter-spacing: var(--ys-ls-wider);
    text-transform: uppercase;
    color: var(--ys-text-muted);
    transition: color var(--ys-dur-base) var(--ys-ease-out);
  }

  .hero__scroll:hover {
    color: var(--ys-text-secondary);
  }

  .hero__scroll-line {
    position: relative;
    display: block;
    inline-size: 1px;
    block-size: 2.6rem;
    background: linear-gradient(to bottom, transparent, var(--ys-purple));
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inline-size: 100%;
    block-size: 40%;
    background: var(--ys-lavender);
    animation: ys-scroll-cue 2.4s var(--ys-ease-smooth) infinite;
  }

  @keyframes ys-scroll-cue {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(250%);
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-block-size: 92svh;
    }

    .hero__lede {
      font-size: var(--ys-fs-sm);
    }

    .hero__actions {
      flex-direction: column;
      gap: var(--ys-space-md);
    }
  }
</style>
