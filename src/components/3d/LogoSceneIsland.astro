---
/**
 * 3D 场景的宿主容器。
 *
 * 挂载方式：显式 import + createRoot，而非 Astro 的 client:* 指令。
 * 原因见 src/components/3d/mountScene.tsx 的注释——
 * Astro island 注水依赖的事件在解析早期同步派发，存在错过事件的竞态，
 * 会导致 3D 场景静默消失且无任何报错。
 *
 * 职责边界：
 *   · 场景加载失败时静默降级，CSS 占位几何体继续承担视觉；
 *   · 关键信息（字标、正文）始终由静态 HTML 提供，不依赖 Canvas；
 *   · 页面切换时精确卸载，释放 WebGL 上下文。
 */
---

<div class="scene-root" data-scene-root></div>

<script>
  import { mountScene, unmountScene } from '@/components/3d/mountScene';

  const root = document.querySelector<HTMLElement>('[data-scene-root]');

  if (root) {
    mountScene(root).catch(() => {
      // 挂载失败时保持 CSS 占位，不阻断页面其余部分
      root.dataset.sceneFallback = 'true';
    });
  }

  // 页面切换（或导航替换）前卸载，释放 GPU 资源
  document.addEventListener('astro:before-swap', unmountScene);
  window.addEventListener('pagehide', unmountScene);
</script>

<style>
  .scene-root {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* 场景未就绪时由 CSS 占位元素负责画面，这里保持透明 */
    pointer-events: none;
    opacity: 0;
    animation: scene-fade-in var(--ys-dur-cinematic) var(--ys-ease-out) forwards;
  }

  @keyframes scene-fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-root {
      animation-duration: 0.01ms;
      opacity: 1;
    }
  }
</style>
