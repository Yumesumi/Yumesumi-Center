---
/**
 * 3D 场景的 Astro 包装层。
 *
 * 职责边界：
 *   · 只在客户端注水（client:only），避免 SSR 阶段触碰 WebGL；
 *   · 场景加载失败时静默降级，CSS 占位几何体继续承担视觉；
 *   · 关键信息（字标、正文）始终由静态 HTML 提供，不依赖 Canvas。
 */
import LogoScene from './LogoScene';

interface Props {
  /** 低性能设备提示 */
  lowPower?: boolean;
}

const { lowPower = false } = Astro.props;
---

<div class="scene-root" data-scene-root>
  <LogoScene client:only="react" lowPower={lowPower} />
</div>

<style>
  .scene-root {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* 场景未就绪时由 CSS 占位元素负责画面，这里保持透明 */
    pointer-events: none;
    opacity: 0;
    animation: scene-fade-in var(--ys-dur-cinematic) var(--ys-ease-out) forwards;
  }

  @keyframes scene-fade-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-root {
      animation-duration: 0.01ms;
      opacity: 1;
    }
  }
</style>
